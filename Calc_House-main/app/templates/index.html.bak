<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BuildMate - Калькулятор строительства дома</title>
    <meta name="description" content="Интерактивный калькулятор стоимости строительства дома с ИИ-рекомендациями">

    <!-- Подключение Tailwind CSS через CDN (для демонстрации, в продакшене лучше использовать сборку) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- React и React DOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>

    <!-- Babel для поддержки JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <!-- Дополнительные стили -->
    <style>
        .hero-section {
            background-image: url('https://images.unsplash.com/photo-1600607686527-6fb886090705?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2340&q=80');
            background-size: cover;
            background-position: center;
            height: 500px;
        }
    </style>
</head>

<body class="font-sans bg-gray-100">
    <!-- Корневой элемент для React-приложения -->
    <div id="root"></div>

    <!-- React-компоненты -->
    <script type="text/babel">
        {% raw %}
        // Компонент шага калькулятора
        const CalculatorStep = ({ title, children, currentStep, stepNumber }) => {
            const isActive = currentStep === stepNumber;

            return (
                <div className={`transition-all duration-300 ${isActive ? 'opacity-100' : 'opacity-0 hidden'}`}>
                    <h3 className="text-2xl font-bold mb-6">{title}</h3>
                    {children}
                </div>
            );
        };

        // Компонент для карточки выбора с иконкой
        const OptionCard = ({ title, icon, description, value, selectedValue, onSelect }) => {
            const isSelected = value === selectedValue;

            return (
                <div
                    className={`border-2 rounded-lg p-4 cursor-pointer transition-all ${isSelected ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                    onClick={() => onSelect(value)}
                >
                    <div className="flex items-center mb-2">
                        <div className="text-3xl mr-3">{icon}</div>
                        <h4 className="text-lg font-semibold">{title}</h4>
                    </div>
                    <p className="text-gray-600 text-sm">{description}</p>
                </div>
            );
        };

        // Компонент для шапки сайта
        const Header = () => (
            <header className="bg-white shadow-md">
                <div className="container mx-auto px-4 py-3 flex justify-between items-center">
                    <div className="flex items-center">
                        <h1 className="text-2xl font-bold text-gray-800">BuildMate</h1>
                    </div>
                    <nav>
                        <ul className="flex space-x-6">
                            <li><a href="#" className="text-gray-600 hover:text-blue-500">Главная</a></li>
                            <li><a href="#calculator" className="text-gray-600 hover:text-blue-500">Калькулятор</a></li>
                            <li><a href="#features" className="text-gray-600 hover:text-blue-500">Возможности</a></li>
                            <li><a href="#" className="text-gray-600 hover:text-blue-500">Контакты</a></li>
                        </ul>
                    </nav>
                </div>
            </header>
        );

        // Hero секция
        const HeroSection = () => (
            <section class="hero-section flex items-center">
                <div class="container mx-auto px-4">
                    <div class="max-w-2xl bg-white bg-opacity-90 p-8 rounded-lg shadow-lg">
                        <h2 class="text-4xl font-bold mb-4">Рассчитайте стоимость строительства дома</h2>
                        <p class="text-xl mb-6">Онлайн калькулятор поможет спланировать бюджет и получить рекомендации</p>
                        <a href="#calculator" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg inline-block">Начать расчет</a>
                    </div>
                </div>
            </section>
        );

        // Главный компонент калькулятора
        const Calculator = () => {
            // Состояние для хранения текущего шага и данных калькулятора
            const [currentStep, setCurrentStep] = React.useState(1);
            const [calculatorData, setCalculatorData] = React.useState({
                area: 150,
                foundationType: 'strip',
                wallMaterial: 'brick',
                floors: 1,
                roofType: 'metal',
                additionalOptions: []
            });
            const [calculationResult, setCalculationResult] = React.useState(null);
            const [recommendations, setRecommendations] = React.useState(null);
            const [isLoading, setIsLoading] = React.useState(false);

            // Обработчики изменения данных
            const handleInputChange = (e) => {
                const { name, value } = e.target;
                setCalculatorData({ ...calculatorData, [name]: value });
            };

            const handleOptionSelect = (field, value) => {
                setCalculatorData({ ...calculatorData, [field]: value });
            };

            const handleAdditionalOptionToggle = (option) => {
                const currentOptions = [...calculatorData.additionalOptions];
                const optionIndex = currentOptions.indexOf(option);

                if (optionIndex === -1) {
                    currentOptions.push(option);
                } else {
                    currentOptions.splice(optionIndex, 1);
                }

                setCalculatorData({ ...calculatorData, additionalOptions: currentOptions });
            };

            // Переход к следующему шагу
            const nextStep = () => {
                if (currentStep < 6) {
                    setCurrentStep(currentStep + 1);
                } else {
                    calculateResult();
                }
            };

            // Переход к предыдущему шагу
            const prevStep = () => {
                if (currentStep > 1) {
                    setCurrentStep(currentStep - 1);
                }
            };

            // Расчет результата
            const calculateResult = async () => {
                setIsLoading(true);

                try {
                    // Подготовка данных для отправки на сервер
                    const apiData = {
                        area: parseFloat(calculatorData.area),
                        foundation_type: calculatorData.foundationType,
                        wall_material: calculatorData.wallMaterial,
                        floors: parseInt(calculatorData.floors),
                        roof_type: calculatorData.roofType,
                        additional_options: calculatorData.additionalOptions
                    };

                    // Запрос к API для расчета
                    const response = await fetch('/api/calculate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(apiData)
                    });

                    if (!response.ok) {
                        throw new Error('Ошибка при расчете');
                    }

                    const result = await response.json();
                    setCalculationResult(result);

                    // Получение рекомендаций
                    const recommendationsResponse = await fetch('/api/recommendations', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            calculator_data: apiData
                        })
                    });

                    if (recommendationsResponse.ok) {
                        const recommendationsData = await recommendationsResponse.json();
                        setRecommendations(recommendationsData);
                    }

                    // Переход к результатам
                    setCurrentStep(7);
                } catch (error) {
                    console.error('Ошибка при расчете:', error);
                    alert('Произошла ошибка при расчете. Пожалуйста, попробуйте еще раз.');
                } finally {
                    setIsLoading(false);
                }
            };

            // Форматирование числа как цены
            const formatPrice = (price) => {
                return new Intl.NumberFormat('ru-RU').format(Math.round(price));
            };

            // Сброс и начало нового расчета
            const resetCalculator = () => {
                setCalculatorData({
                    area: 150,
                    foundationType: 'strip',
                    wallMaterial: 'brick',
                    floors: 1,
                    roofType: 'metal',
                    additionalOptions: []
                });
                setCalculationResult(null);
                setRecommendations(null);
                setCurrentStep(1);
            };

            return (
                <div className="bg-white rounded-lg shadow-lg p-6 max-w-4xl mx-auto">
                    {/* Прогресс-бар (не отображается на странице результатов) */}
                    {currentStep < 7 && (
                        <div className="mb-8">
                            <div className="flex justify-between mb-2">
                                <span className="text-sm font-medium">Шаг {currentStep} из 6</span>
                                <span className="text-sm font-medium">{Math.round((currentStep / 6) * 100)}%</span>
                            </div>
                            <div className="w-full bg-gray-200 rounded-full h-2.5">
                                <div
                                    className="bg-blue-600 h-2.5 rounded-full transition-all duration-300"
                                    {% raw %} style={{ width: `${(currentStep / 6) * 100}%` }}{% endraw %}
                                ></div>
                            </div>
                        </div>
                    )}

                    {/* Шаги калькулятора */}
                    <div className="min-h-[400px]">
                        {/* Шаг 1: Площадь дома */}
                        <CalculatorStep title="Площадь дома" currentStep={currentStep} stepNumber={1}>
                            <div className="mb-6">
                                <label className="block text-gray-700 font-semibold mb-2">
                                    Укажите площадь дома в квадратных метрах
                                </label>
                                <input
                                    type="number"
                                    name="area"
                                    value={calculatorData.area}
                                    onChange={handleInputChange}
                                    min="20"
                                    max="1000"
                                    className="w-full border-2 border-gray-300 rounded-lg p-3 focus:border-blue-500 focus:outline-none"
                                />
                            </div>
                            <div className="flex items-center justify-center">
                                <div className="text-center p-4 bg-blue-50 rounded-lg border border-blue-100 mb-6">
                                    <div className="text-4xl mb-2">🏠</div>
                                    <div className="font-semibold">
                                        Планируемая площадь: {calculatorData.area} м²
                                    </div>
                                </div>
                            </div>
                        </CalculatorStep>

                        {/* Шаг 2: Тип фундамента */}
                        <CalculatorStep title="Выберите тип фундамента" currentStep={currentStep} stepNumber={2}>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                <OptionCard
                                    title="Ленточный"
                                    icon="🧱"
                                    description="Классический вариант для большинства домов"
                                    value="strip"
                                    selectedValue={calculatorData.foundationType}
                                    onSelect={(value) => handleOptionSelect('foundationType', value)}
                                />
                                <OptionCard
                                    title="Свайный"
                                    icon="⛏️"
                                    description="Хороший выбор для сложных грунтов"
                                    value="pile"
                                    selectedValue={calculatorData.foundationType}
                                    onSelect={(value) => handleOptionSelect('foundationType', value)}
                                />
                                <OptionCard
                                    title="Плитный"
                                    icon="▬"
                                    description="Надежное решение для любых грунтов"
                                    value="slab"
                                    selectedValue={calculatorData.foundationType}
                                    onSelect={(value) => handleOptionSelect('foundationType', value)}
                                />
                                <OptionCard
                                    title="Столбчатый"
                                    icon="◙"
                                    description="Экономичный вариант для легких построек"
                                    value="column"
                                    selectedValue={calculatorData.foundationType}
                                    onSelect={(value) => handleOptionSelect('foundationType', value)}
                                />
                            </div>
                        </CalculatorStep>

                        {/* Шаг 3: Материал стен */}
                        <CalculatorStep title="Материал стен" currentStep={currentStep} stepNumber={3}>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                <OptionCard
                                    title="Кирпич"
                                    icon="🧱"
                                    description="Прочный и долговечный классический материал"
                                    value="brick"
                                    selectedValue={calculatorData.wallMaterial}
                                    onSelect={(value) => handleOptionSelect('wallMaterial', value)}
                                />
                                <OptionCard
                                    title="Дерево"
                                    icon="🌲"
                                    description="Экологичный материал с хорошей теплоизоляцией"
                                    value="wood"
                                    selectedValue={calculatorData.wallMaterial}
                                    onSelect={(value) => handleOptionSelect('wallMaterial', value)}
                                />
                                <OptionCard
                                    title="Блоки"
                                    icon="▭"
                                    description="Популярный выбор с хорошим соотношением цена/качество"
                                    value="block"
                                    selectedValue={calculatorData.wallMaterial}
                                    onSelect={(value) => handleOptionSelect('wallMaterial', value)}
                                />
                                <OptionCard
                                    title="Монолитный бетон"
                                    icon="◨"
                                    description="Долговечный материал с высокой прочностью"
                                    value="concrete"
                                    selectedValue={calculatorData.wallMaterial}
                                    onSelect={(value) => handleOptionSelect('wallMaterial', value)}
                                />
                                <OptionCard
                                    title="Панели"
                                    icon="▤"
                                    description="Быстровозводимое и экономичное решение"
                                    value="panel"
                                    selectedValue={calculatorData.wallMaterial}
                                    onSelect={(value) => handleOptionSelect('wallMaterial', value)}
                                />
                            </div>
                        </CalculatorStep>

                        {/* Шаг 4: Количество этажей */}
                        <CalculatorStep title="Количество этажей" currentStep={currentStep} stepNumber={4}>
                            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                                <OptionCard
                                    title="1 этаж"
                                    icon="🏠"
                                    description="Классический одноэтажный дом"
                                    value={1}
                                    selectedValue={calculatorData.floors}
                                    onSelect={(value) => handleOptionSelect('floors', value)}
                                />
                                <OptionCard
                                    title="2 этажа"
                                    icon="🏘️"
                                    description="Оптимальное решение для большинства семей"
                                    value={2}
                                    selectedValue={calculatorData.floors}
                                    onSelect={(value) => handleOptionSelect('floors', value)}
                                />
                                <OptionCard
                                    title="3 этажа"
                                    icon="🏢"
                                    description="Максимальная площадь на минимальном участке"
                                    value={3}
                                    selectedValue={calculatorData.floors}
                                    onSelect={(value) => handleOptionSelect('floors', value)}
                                />
                            </div>
                        </CalculatorStep>

                        {/* Шаг 5: Тип кровли */}
                        <CalculatorStep title="Тип кровли" currentStep={currentStep} stepNumber={5}>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                <OptionCard
                                    title="Металлочерепица"
                                    icon="🏠"
                                    description="Популярный и доступный материал"
                                    value="metal"
                                    selectedValue={calculatorData.roofType}
                                    onSelect={(value) => handleOptionSelect('roofType', value)}
                                />
                                <OptionCard
                                    title="Керамическая черепица"
                                    icon="🏛️"
                                    description="Премиальный выбор с высокой долговечностью"
                                    value="tile"
                                    selectedValue={calculatorData.roofType}
                                    onSelect={(value) => handleOptionSelect('roofType', value)}
                                />
                                <OptionCard
                                    title="Гибкая черепица"
                                    icon="🏡"
                                    description="Универсальный материал для сложных форм крыши"
                                    value="shingle"
                                    selectedValue={calculatorData.roofType}
                                    onSelect={(value) => handleOptionSelect('roofType', value)}
                                />
                                <OptionCard
                                    title="Шифер"
                                    icon="🏚️"
                                    description="Бюджетный и проверенный временем вариант"
                                    value="slate"
                                    selectedValue={calculatorData.roofType}
                                    onSelect={(value) => handleOptionSelect('roofType', value)}
                                />
                                <OptionCard
                                    title="Плоская кровля"
                                    icon="▭"
                                    description="Современный выбор с возможностью обустройства террасы"
                                    value="flat"
                                    selectedValue={calculatorData.roofType}
                                    onSelect={(value) => handleOptionSelect('roofType', value)}
                                />
                            </div>
                        </CalculatorStep>

                        {/* Шаг 6: Дополнительные опции */}
                        <CalculatorStep title="Дополнительные опции" currentStep={currentStep} stepNumber={6}>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('garage') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('garage')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🚗</div>
                                        <h4 className="text-lg font-semibold">Гараж</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Пристроенный или встроенный гараж для автомобиля</p>
                                </div>
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('basement') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('basement')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🏗️</div>
                                        <h4 className="text-lg font-semibold">Подвал</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Дополнительное подвальное помещение</p>
                                </div>
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('terrace') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('terrace')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🏞️</div>
                                        <h4 className="text-lg font-semibold">Терраса</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Открытая терраса для отдыха</p>
                                </div>
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('balcony') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('balcony')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🪟</div>
                                        <h4 className="text-lg font-semibold">Балкон</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Балкон на втором или третьем этаже</p>
                                </div>
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('warm_floor') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('warm_floor')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🔥</div>
                                        <h4 className="text-lg font-semibold">Теплый пол</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Система подогрева пола</p>
                                </div>
                                <div
                                    className={`border-2 rounded-lg p-4 cursor-pointer ${calculatorData.additionalOptions.includes('smart_home') ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                                    onClick={() => handleAdditionalOptionToggle('smart_home')}
                                >
                                    <div className="flex items-center mb-2">
                                        <div className="text-3xl mr-3">🤖</div>
                                        <h4 className="text-lg font-semibold">Умный дом</h4>
                                    </div>
                                    <p className="text-gray-600 text-sm">Система автоматизации для управления домом</p>
                                </div>
                            </div>
                        </CalculatorStep>

                        {/* Шаг 7: Результаты */}
                        <CalculatorStep title="Результаты расчета" currentStep={currentStep} stepNumber={7}>
                            {isLoading ? (
                                <div className="flex flex-col items-center justify-center py-10">
                                    <div className="animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-blue-500 mb-4"></div>
                                    <p className="text-lg">Выполняем расчеты...</p>
                                </div>
                            ) : calculationResult ? (
                                <div>
                                    <div className="bg-blue-50 border border-blue-100 rounded-lg p-6 mb-8">
                                        <h3 className="text-2xl font-bold text-blue-800 mb-4">Общая стоимость строительства</h3>
                                        <div className="text-3xl font-bold mb-2">{formatPrice(calculationResult.total_price)} ₽</div>
                                        <div className="text-lg">{formatPrice(calculationResult.price_per_sqm)} ₽ за м²</div>
                                        {calculationResult.estimated_time && (
                                            <div className="mt-4 text-gray-600">
                                                Ориентировочное время строительства: {calculationResult.estimated_time} дней
                                            </div>
                                        )}
                                    </div>

                                    <h4 className="text-xl font-bold mb-4">Детализация расчета</h4>
                                    <div className="mb-8">
                                        {calculationResult.breakdown.map((item, index) => (
                                            <div key={index} className="border-b py-3">
                                                <div className="flex justify-between">
                                                    <span className="font-medium">{item.category}</span>
                                                    <span className="font-bold">{formatPrice(item.price)} ₽</span>
                                                </div>
                                                {item.details && item.details.length > 0 && (
                                                    <div className="mt-2 text-sm text-gray-600">
                                                        {item.details.map((detail, i) => (
                                                            <div key={i} className="ml-4">
                                                                {detail.name && <span>{detail.name}</span>}
                                                                {detail.price_per_sqm && <span> - {formatPrice(detail.price_per_sqm)} ₽/м²</span>}
                                                            </div>
                                                        ))}
                                                    </div>
                                                )}
                                            </div>
                                        ))}
                                    </div>

                                    {recommendations && (
                                        <div className="mt-8">
                                            <h4 className="text-xl font-bold mb-4">Рекомендации по строительству</h4>
                                            <div className="bg-green-50 border border-green-100 rounded-lg p-4 mb-4">
                                                <p className="text-green-800">{recommendations.summary}</p>
                                            </div>

                                            {recommendations.recommendations.map((rec, index) => (
                                                <div key={index} className="bg-white shadow-md rounded-lg p-4 mb-4">
                                                    <h5 className="font-bold text-lg mb-2">{rec.title}</h5>
                                                    <p className="text-gray-700 mb-2">{rec.description}</p>
                                                    <div className="text-sm text-gray-600">
                                                        <strong>Эффект:</strong> {rec.impact}
                                                        {rec.estimated_savings && (
                                                            <span className="text-green-600 ml-2">
                                                                (экономия до {rec.estimated_savings}%)
                                                            </span>
                                                        )}
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    )}

                                    <div className="mt-6 text-center">
                                        <button
                                            className="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg mr-4"
                                            onClick={resetCalculator}
                                        >
                                            Новый расчет
                                        </button>
                                        <button
                                            className="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-6 rounded-lg"
                                            onClick={() => window.print()}
                                        >
                                            Распечатать результаты
                                        </button>
                                    </div>
                                </div>
                            ) : (
                                <div className="text-center py-10">
                                    <p className="text-lg text-gray-600">Нет данных для отображения</p>
                                    <button
                                        className="mt-4 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg"
                                        onClick={resetCalculator}
                                    >
                                        Начать расчет
                                    </button>
                                </div>
                            )}
                        </CalculatorStep>
                    </div>

                    {/* Кнопки навигации (не отображаются на странице результатов) */}
                    {currentStep < 7 && (
                        <div className="flex justify-between mt-8">
                            <button
                                className={`font-bold py-2 px-6 rounded-lg ${currentStep === 1
                                    ? 'bg-gray-300 cursor-not-allowed'
                                    : 'bg-gray-500 hover:bg-gray-600 text-white'
                                    }`}
                                onClick={prevStep}
                                disabled={currentStep === 1}
                            >
                                Назад
                            </button>
                            <button
                                className="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg"
                                onClick={nextStep}
                            >
                                {currentStep === 6 ? 'Рассчитать' : 'Далее'}
                            </button>
                        </div>
                    )}
                </div>
            );
        };

        // Секция с калькулятором
        const CalculatorSection = () => (
            <section id="calculator" class="py-16 bg-white">
                <div class="container mx-auto px-4">
                    <h2 class="text-3xl font-bold mb-10 text-center">Калькулятор строительства</h2>
                    <Calculator />
                </div>
            </section>
        );

        // Секция преимуществ
        const FeaturesSection = () => (
            <section id="features" class="py-16 bg-gray-100">
                <div class="container mx-auto px-4">
                    <h2 class="text-3xl font-bold mb-10 text-center">Наши преимущества</h2>

                    <div class="grid md:grid-cols-3 gap-8">
                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <div class="text-blue-600 text-4xl mb-4">🏠</div>
                            <h3 class="text-xl font-bold mb-2">Точные расчеты</h3>
                            <p class="text-gray-600">Наш калькулятор учитывает все основные параметры и особенности строительства для точной оценки стоимости.</p>
                        </div>

                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <div class="text-blue-600 text-4xl mb-4">💰</div>
                            <h3 class="text-xl font-bold mb-2">Экономия бюджета</h3>
                            <p class="text-gray-600">Получите персональные рекомендации по оптимизации проекта и экономии средств.</p>
                        </div>

                        <div class="bg-white p-6 rounded-lg shadow-md">
                            <div class="text-blue-600 text-4xl mb-4">🔧</div>
                            <h3 class="text-xl font-bold mb-2">Профессиональный подход</h3>
                            <p class="text-gray-600">Алгоритмы калькулятора основаны на опыте профессиональных строителей и актуальных рыночных ценах.</p>
                        </div>
                    </div>
                </div>
            </section>
        );

        // Футер
        const Footer = () => (
            <footer class="bg-gray-800 text-white py-8">
                <div class="container mx-auto px-4">
                    <div class="grid md:grid-cols-3 gap-8">
                        <div>
                            <h3 class="text-xl font-bold">BuildMate</h3>
                            <p class="mt-2">Онлайн калькулятор строительства дома с рекомендациями по оптимизации бюджета.</p>
                        </div>

                        <div>
                            <h4 class="text-lg font-bold mb-2">Навигация</h4>
                            <ul class="space-y-1">
                                <li><a href="#" class="hover:text-blue-300">Главная</a></li>
                                <li><a href="#calculator" class="hover:text-blue-300">Калькулятор</a></li>
                                <li><a href="#features" class="hover:text-blue-300">Возможности</a></li>
                                <li><a href="#" class="hover:text-blue-300">Контакты</a></li>
                            </ul>
                        </div>

                        <div>
                            <h4 class="text-lg font-bold mb-2">Связаться с нами</h4>
                            <p>info@buildmate.ru</p>
                            <p>+7 (123) 456-78-90</p>
                        </div>
                    </div>

                    <div class="border-t border-gray-700 mt-8 pt-4 text-center text-sm">
                        <p>&copy; 2024 BuildMate. Все права защищены.</p>
                    </div>
                </div>
            </footer>
        );

        // Основное приложение
        const App = () => (
            <>
                <Header />
                <HeroSection />
                <CalculatorSection />
                <FeaturesSection />
                <Footer />
            </>
        );

        // Рендеринг приложения
        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>

</html>